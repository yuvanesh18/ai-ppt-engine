# AI-Powered PowerPoint Generator — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# -------------------------------------------------------
# LLM provider selection: "groq" or "watsonx"
# -------------------------------------------------------
LLM_PROVIDER=watsonx

# -------------------------------------------------------
# Groq Cloud API
# Get your key at: https://console.groq.com/keys
# -------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# -------------------------------------------------------
# Model selection (optional — defaults shown below)
# Recommended: openai/gpt-oss-120b (best reasoning & structure adherence)
# Alternatives: openai/gpt-oss-20b, qwen/qwen3.6-27b
# -------------------------------------------------------
GROQ_MODEL=openai/gpt-oss-120b

# -------------------------------------------------------
# IBM watsonx.ai
# Create a project + API key at: https://dataplatform.cloud.ibm.com
# WATSONX_MODEL_ID must match an ID from your project's model catalog
# (Prompt Lab > View code), e.g. openai/gpt-oss-120b, ibm/granite-3-8b-instruct.
# -------------------------------------------------------
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
# Optional: one project ID per key in WATSONX_API_KEYS, same order, so each
# collaborator's usage bills against their own project instead of a shared one.
# WATSONX_PROJECT_IDS=project_id_1,project_id_2,project_id_3
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct
WATSONX_MAX_TOKENS_PLAN=4096
WATSONX_MAX_TOKENS_SLIDE=2048
WATSONX_TEMPERATURE=0.3

# -------------------------------------------------------
# Generation settings (optional)
# -------------------------------------------------------
# Maximum tokens for planning stage
GROQ_MAX_TOKENS_PLAN=4096

# Maximum tokens for per-slide content generation
GROQ_MAX_TOKENS_SLIDE=2048

# Temperature (0.0 = deterministic, 1.0 = creative)
GROQ_TEMPERATURE=0.3

# Maximum retries on JSON parse failure
LLM_MAX_RETRIES=3

# -------------------------------------------------------
# Application settings (optional)
# -------------------------------------------------------
# Maximum file upload size in MB
MAX_UPLOAD_SIZE_MB=20

# Maximum source text length sent to LLM (characters)
MAX_SOURCE_TEXT_CHARS=12000

# Output directory (relative to project root)
OUTPUT_DIR=output
